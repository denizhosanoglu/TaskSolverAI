{
  "manifest_version": 3,
  "name": "Vocab Autofill",
  "version": "2.0.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://*.script.googleusercontent.com/*",
    "https://*.googleusercontent.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
